FROM golang:1.26-alpine AS api-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY server/backend ./server/backend
RUN CGO_ENABLED=0 go build -o /out/anoq ./cmd/server

FROM alpine:3 AS api
COPY --from=api-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=api-build /out/anoq /usr/local/bin/anoq
USER nobody
CMD ["anoq"]

FROM node:24-bookworm-slim AS web
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --chown=node:node . .
RUN chown node:node /app
USER node
CMD ["npm", "run", "dev", "--", "--webpack", "--hostname", "0.0.0.0"]
